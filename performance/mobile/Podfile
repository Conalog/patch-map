platform :ios, '13.0'
ENV['COCOAPODS_DISABLE_STATS'] = 'true'
project 'Runner', 'Debug' => :debug, 'Profile' => :release, 'Release' => :release

def flutter_root
  path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  File.foreach(path) do |line|
    match = line.match(/FLUTTER_ROOT\=(.*)/)
    return match[1].strip if match
  end
  raise 'FLUTTER_ROOT missing; run flutter pub get'
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)
flutter_ios_podfile_setup
target 'Runner' do
  use_frameworks!
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    next unless ['jsf', 'quickjs_engine'].include?(target.name)
    target.build_configurations.each do |config|
      # Simulator requires Dart debug/JIT, but the embedded C engine need not be unoptimized.
      config.build_settings['GCC_OPTIMIZATION_LEVEL'] = '3'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = ['$(inherited)', 'NDEBUG=1']
    end
    if target.name == 'quickjs_engine'
      # The 0.1.5 podspec's ../native globs omit C/C++ sources from the pod target.
      # Add the published sources explicitly without editing the package cache.
      native = File.join(__dir__, '.symlinks', 'plugins', 'quickjs_engine', 'native', 'cxx')
      group = installer.pods_project.main_group.find_subpath('PatchMap QuickJS sources', true)
      ['libfastdev_quickjs_runtime.cpp', 'quickjs/quickjs.c', 'quickjs/libregexp.c',
       'quickjs/libunicode.c', 'quickjs/dtoa.c'].each do |relative|
        path = File.realpath(File.join(native, relative))
        next if target.source_build_phase.files_references.any? { |ref| ref.real_path.to_s == path }
        target.source_build_phase.add_file_reference(group.new_file(path), true)
      end
    end
  end
end
