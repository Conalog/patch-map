{
  "name": "@patch-map/verification",
  "private": true,
  "type": "module",
  "description": "Repository-only tooling for the JavaScript and Flutter packages",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "cd .. && eslint --config verification/eslint.config.js verification .github/scripts",
    "test": "cd .. && node --test verification/*.test.mjs verification/conformance/*.test.mjs verification/flutter/*.test.mjs .github/scripts/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "docs": "cd .. && node verification/docs/verify.mjs",
    "flutter:analyze": "cd .. && node verification/flutter/run.mjs analyze",
    "flutter:test": "cd .. && node verification/flutter/run.mjs test",
    "flutter:package": "cd .. && node verification/flutter/run.mjs package",
    "flutter:verify": "cd .. && node verification/flutter/run.mjs verify"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.9",
    "eslint": "10.7.0",
    "pixi.js": "8.19.0",
    "playwright": "1.57.0",
    "release-please": "17.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "yaml": "2.9.1"
  }
}
