{
  "name": "@patch-map/verification",
  "private": true,
  "type": "module",
  "description": "Repository-only tooling for the JavaScript and Flutter packages",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "cd .. && eslint --config verification/eslint.config.js verification .github/scripts",
    "test": "cd .. && node --test verification/*.test.mjs verification/conformance/*.test.mjs verification/flutter/installed-consumer.test.mjs .github/scripts/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "docs": "cd .. && node verification/docs/verify.mjs",
    "conformance": "cd .. && node verification/conformance/inventory.mjs && node verification/conformance/run-public.mjs",
    "conformance:serve": "cd .. && vite --config verification/conformance/vite.config.ts --host 127.0.0.1",
    "flutter:package": "cd .. && node verification/flutter/package.mjs && node verification/flutter/installed-consumer.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.9",
    "eslint": "10.7.0",
    "pixi.js": "8.19.0",
    "playwright": "1.57.0",
    "release-please": "17.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6"
  }
}
