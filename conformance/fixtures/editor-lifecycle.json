{
  "schemaRevision": "patch-map-conformance/1",
  "id": "editor-lifecycle",
  "description": "Named relation conflicts/removal, text recovery/cancel/delete, mode replacement, and host-confirmed cascade delete public workflows.",
  "surface": {
    "width": 480,
    "height": 520,
    "pixelRatio": 1,
    "background": "#f8fafc"
  },
