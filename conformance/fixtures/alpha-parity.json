        "text": {
          "changes": {
            "margin": 4
          }
        }
      }
    },
    {
      "id": "reset-source-and-margin",
      "op": "update",
      "input": {
        "id": "g.0.0",
        "bar": {
          "changes": {
            "source": null
          }
        },
        "text": {
          "changes": {
            "margin": null
          }
        }
      }
    },
    {
      "id": "final-fit",
      "op": "viewport.fit",
      "input": {}
