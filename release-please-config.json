{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "6986c632a47d3443ff17903c416291dfe4120340",
  "changelog-sections": [
    {
      "section": "Added",
      "type": "feat"
    },
    {
      "section": "Fixed",
      "type": "fix"
    },
    {
      "section": "Changed",
      "type": "perf"
    },
    {
      "section": "Maintenance",
      "type": "deps"
    }
  ],
  "include-component-in-tag": true,
  "include-v-in-release-name": true,
  "include-v-in-tag": true,
  "packages": {
    "packages/flutter": {
      "component": "dart",
      "include-component-in-tag": true,
      "initial-version": "1.0.0-alpha.1",
      "package-name": "conalog_patch_map",
      "prerelease": true,
      "prerelease-type": "alpha",
      "release-type": "dart",
      "versioning": "prerelease"
    },
    "packages/javascript": {
      "component": "js",
      "include-component-in-tag": true,
      "package-name": "@conalog/patch-map",
      "prerelease": true,
      "prerelease-type": "alpha",
      "release-type": "node",
      "versioning": "prerelease"
    }
  },
  "plugins": [
    {
      "merge": false,
      "type": "node-workspace"
    }
  ],
  "pull-request-title-pattern": "chore: release ${component} ${version}",
  "separate-pull-requests": true
}
