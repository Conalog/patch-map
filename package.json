{
  "type": "module",
  "name": "@conalog/patch-map",
  "version": "0.10.0",
  "description": "This library utilizes pixi.js to provide a PATCH MAP tailored to the requirements of the PATCH service.",
  "license": "MIT",
  "author": "Conalog",
  "keywords": [],
  "homepage": "https://github.com/Conalog/patch-map#readme",
  "bugs": "https://github.com/Conalog/patch-map/issues",
  "engines": {
    "node": ">=22.22.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Conalog/patch-map.git"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "umd": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "sideEffects": true,
  "scripts": {
    "build": "npm run clean && tsc && rollup -c",
    "check": "biome check .",
    "clean": "node scripts/clean.mjs",
    "format": "biome format",
    "lint": "biome check --staged",
    "lint:fix": "biome check --staged --write",
    "pack:check": "node scripts/check-package.mjs",
    "test": "npm run test:unit && npm run test:headless",
    "test:unit": "vitest --run --project unit",
    "test:browser": "vitest --run --project browser --browser=chromium",
    "test:headless": "vitest --run --project browser --browser.headless --no-file-parallelism",
    "prepare": "husky",
    "prepack": "npm run build"
  },
  "files": [
    "dist/index.cjs",
    "dist/index.esm.js",
    "dist/index.umd.js",
    "dist/index.d.ts",
    "dist/index.d.cts",
    "dist/assets/fonts/OFL-1.1.txt"
  ],
  "dependencies": {
    "@pixi-essentials/bounds": "^3.0.0",
    "gsap": "^3.15.0",
    "is-plain-object": "^5.0.0",
    "jsonpath-plus": "^10.4.0",
    "nanoid": "^6.0.1",
    "pixi-viewport": "^6.0.3",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "peerDependencies": {
    "pixi.js": ">=8"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.9",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-url": "^8.0.2",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "pixi.js": "^8.19.0",
    "playwright": "^1.62.1",
    "publint": "^0.3.23",
    "rollup": "^4.62.4",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
