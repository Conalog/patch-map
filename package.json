{
  "name": "@conalog/patch-map",
  "version": "0.10.0",
  "description": "PATCH MAP v0.10 compatibility library with performance-first Core v1 and PixiJS Core v2 subpaths",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core-v1": {
      "types": "./dist/core-v1/index.d.ts",
      "import": "./dist/core-v1.js",
      "require": "./dist/core-v1.cjs"
    },
    "./core-v2": {
      "types": "./dist/core-v2/index.d.ts",
      "import": "./dist/core-v2.js",
      "require": "./dist/core-v2.cjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "docs/core-v2",
    "examples/core-v2",
    "LICENSE",
    "README.md",
    "README_KR.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --config vite.core-v1.config.ts && vite build --config vite.core-v2.config.ts && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/verification/finalize-declarations.mjs",
    "build:core-v1": "vite build --config vite.core-v1.config.ts && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/verification/finalize-declarations.mjs",
    "build:core-v2": "vite build --config vite.core-v2.config.ts && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/verification/finalize-declarations.mjs",
    "build:lab": "vite build --config vite.lab.config.ts",
    "build:lab:core-v1": "vite build --config vite.core-v1-lab.config.ts",
    "build:lab:core-v2": "vite build --config vite.core-v2-lab.config.ts",
    "lab": "vite --host 127.0.0.1 --port 4174 --open /lab/",
    "lab:core-v1": "vite --config vite.core-v1-lab.config.ts --host 127.0.0.1 --port 4175 --open /lab/performance-v1/",
    "lab:core-v2": "vite --config vite.core-v2-lab.config.ts --host 127.0.0.1 --port 4176 --open /lab/performance-v2/",
    "lab:core-v2:contract": "vite --config vite.core-v2-lab.config.ts --host 127.0.0.1 --port 4176 --open '/lab/core-v2?scenario=LIF-001&size=100&seed=319'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "unit": "vitest run",
    "test": "npm run typecheck && npm run lint && npm run unit",
    "generate:core-v2-contract-catalog": "node scripts/verification/generate-core-v2-catalog-evidence.mjs",
    "verify:core-v2-decisions": "node scripts/verification/verify-core-v2-decision-evidence.mjs",
    "verify:core-v2-contract-gates": "node scripts/verification/verify-core-v2-catalog-static-gates.mjs",
    "verify:core-v2-contract-catalog": "node scripts/verification/verify-core-v2-catalog.mjs",
    "verify:core-v2-contract": "npm run verify:core-v2-decisions && npm run verify:core-v2-contract-gates && npm run verify:core-v2-contract-catalog",
    "verify:browser": "node scripts/verification/browser-contracts.mjs",
    "verify:memory": "node scripts/verification/memory-contracts.mjs",
    "verify:package": "npm run build && node scripts/verification/package-consumer.mjs",
    "verify:safety": "node scripts/verification/cleanroom-safety.mjs",
    "verify:performance-report": "node scripts/verification/perf-report-verify.mjs",
    "verify:interaction-report": "node scripts/verification/perf-interactions-report-verify.mjs",
    "verify:render-primitives": "node scripts/verification/render-primitives-verify.mjs",
    "verify:lab": "node scripts/verification/browser-lab.mjs",
    "verify:lab:core-v1": "node scripts/verification/core-v1-browser.mjs",
    "verify:lab:core-v2": "node scripts/verification/core-v2-browser.mjs --headed",
    "verify:lab:core-v2:webgpu": "node scripts/verification/core-v2-webgpu-experimental.mjs",
    "verify:lab:core-v2:manual": "node scripts/verification/core-v2-manual-lab-browser.mjs",
    "verify:lab:core-v2:manual:all": "node scripts/verification/core-v2-manual-lab-browser.mjs --all-routes",
    "verify:package:core-v1": "node scripts/verification/core-v1-package.mjs",
    "verify:package:core-v2": "npm run build:core-v2 && node scripts/verification/core-v2-package.mjs",
    "verify:memory:core-v1": "node scripts/verification/core-v1-memory.mjs",
    "verify:memory:core-v2": "node scripts/verification/core-v2-memory.mjs",
    "verify:local": "npm test && npm run conformance -- --repeat 2 && npm run verify:browser && npm run verify:memory && npm run verify:package && npm run verify:safety && npm audit --audit-level=low && npm run perf:check",
    "conformance": "node scripts/conformance/run.mjs",
    "conformance:lifecycle": "node scripts/conformance/run.mjs LIF-001 LIF-002",
    "perf:check": "node scripts/perf/check-bootstrap.mjs",
    "perf:interactions": "node scripts/verification/perf-interactions.mjs",
    "perf:low-end": "node scripts/perf/low-end-benchmark.mjs",
    "perf:core-v1": "node performance/core-v1/selected/run.mjs",
    "perf:core-v1:quick": "node performance/core-v1/selected/run.mjs --quick",
    "perf:core-v2": "node performance/core-v2/run.mjs",
    "perf:core-v2:quick": "node performance/core-v2/run.mjs --quick",
    "perf:core-v2:contract": "node performance/core-v2/contract-run.mjs",
    "perf:core-v2:bar-pan": "node scripts/verification/core-v2-bar-animation-pan-performance.mjs",
    "perf:core-v2:extraction": "node scripts/verification/core-v2-extraction-performance.mjs",
    "verify:performance-report:core-v2": "node performance/core-v2/report/verify.mjs",
    "verify:performance-contract:core-v2": "node performance/core-v2/report/verify-contract.mjs",
    "verify:release-readiness:core-v2": "node scripts/verification/core-v2-release-readiness.mjs",
    "verify:release-readiness:core-v2:strict": "node scripts/verification/core-v2-release-readiness.mjs --require-release"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.9",
    "eslint": "10.7.0",
    "pixi.js": "8.19.0",
    "playwright": "1.57.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.0"
  },
  "dependencies": {
    "eventemitter3": "5.0.1",
    "jsonpath-plus": "10.4.0",
    "pixi-viewport": "6.0.3",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "pixi.js": ">=8.0.0 <9"
  }
}
