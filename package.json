{
  "name": "@conalog/patch-map",
  "version": "1.0.0-alpha.5",
  "description": "PATCH MAP renderer powered by PixiJS",
  "license": "MIT",
  "author": "Conalog",
  "homepage": "https://github.com/Conalog/patch-map#readme",
  "bugs": "https://github.com/Conalog/patch-map/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Conalog/patch-map.git"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "docs/README.md",
    "docs/getting-started.md",
    "docs/api/data-and-targets.md",
    "docs/api/editor-workflows.md",
    "docs/api/mutations-and-history.md",
    "docs/api/pointer-and-selection.md",
    "docs/api/viewport-and-transform.md",
    "docs/api/presentation.md",
    "docs/api/assets-and-capture.md",
    "docs/api/text.md",
    "docs/integration/host.md",
    "docs/compatibility.md",
    "docs/assets/fonts.md",
    "docs/assets/fira-code-6.2-license.txt",
    "examples",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly && node verification/package/finalize-declarations.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "unit": "vitest run --maxWorkers=2",
    "test": "npm run typecheck && npm run lint && npm run unit",
    "verify:docs": "node verification/docs/verify.mjs",
    "performance:smoke": "node performance/runners/benchmark.mjs --smoke",
    "performance:benchmark": "node performance/runners/benchmark.mjs",
    "performance:extraction": "node performance/runners/extraction.mjs",
    "performance:update": "node performance/runners/update.mjs",
    "verify:package": "npm run build && node verification/package/run.mjs",
    "verify:memory": "node performance/runners/memory.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run verify:package -- --require-audit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.9",
    "eslint": "10.7.0",
    "pixi.js": "8.19.0",
    "playwright": "1.57.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.0"
  },
  "peerDependencies": {
    "pixi.js": ">=8.0.0 <9"
  }
}
