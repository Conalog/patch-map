{
  "name": "@conalog/patch-map",
  "version": "0.10.0",
  "description": "Clean-room PATCH MAP v0.10 compatible canvas library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README_KR.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "unit": "vitest run",
    "test": "npm run typecheck && npm run lint && npm run unit",
    "conformance": "node scripts/conformance/run.mjs",
    "conformance:lifecycle": "node scripts/conformance/run.mjs LIF-001 LIF-002",
    "perf:check": "node scripts/perf/check-bootstrap.mjs",
    "perf:low-end": "node scripts/perf/low-end-benchmark.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.9",
    "eslint": "9.39.2",
    "playwright": "1.57.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.52.0",
    "vite": "7.3.6",
    "vitest": "4.1.0"
  },
  "dependencies": {
    "eventemitter3": "5.0.1",
    "jsonpath-plus": "10.4.0",
    "pixi-viewport": "6.0.3",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "pixi.js": ">=8.0.0 <9"
  }
}
