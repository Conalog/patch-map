{
  "name": "patch-map-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/javascript",
    "verification"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "js:build": "npm run build --workspace @conalog/patch-map --",
    "js:typecheck": "npm run typecheck --workspace @conalog/patch-map --",
    "js:lint": "npm run lint --workspace @conalog/patch-map --",
    "js:unit": "npm run unit --workspace @conalog/patch-map --",
    "js:test": "npm run test --workspace @conalog/patch-map --",
    "js:performance:smoke": "npm run performance:smoke --workspace @conalog/patch-map --",
    "js:performance:benchmark": "npm run performance:benchmark --workspace @conalog/patch-map --",
    "js:performance:extraction": "npm run performance:extraction --workspace @conalog/patch-map --",
    "js:performance:update": "npm run performance:update --workspace @conalog/patch-map --",
    "js:verify:memory": "npm run verify:memory --workspace @conalog/patch-map --",
    "js:verify:package": "npm run verify:package --workspace @conalog/patch-map --",
    "flutter:analyze": "npm run flutter:analyze --workspace @patch-map/verification --",
    "flutter:test": "npm run flutter:test --workspace @patch-map/verification --",
    "flutter:verify:package": "npm run flutter:package --workspace @patch-map/verification --",
    "verify:typecheck": "npm run typecheck --workspace @patch-map/verification --",
    "verify:lint": "npm run lint --workspace @patch-map/verification --",
    "verify:tests": "npm run test --workspace @patch-map/verification --",
    "verify:tooling": "npm run check --workspace @patch-map/verification --",
    "verify:docs": "npm run docs --workspace @patch-map/verification --",
    "flutter:verify": "npm run flutter:verify --workspace @patch-map/verification --"
  }
}
