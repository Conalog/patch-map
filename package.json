{
  "name": "patch-map-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/javascript"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "js:build": "npm run build --workspace @conalog/patch-map --",
    "js:typecheck": "npm run typecheck --workspace @conalog/patch-map --",
    "js:lint": "npm run lint --workspace @conalog/patch-map --",
    "js:unit": "npm run unit --workspace @conalog/patch-map --",
    "js:test": "npm run test --workspace @conalog/patch-map --",
    "js:performance:smoke": "npm run performance:smoke --workspace @conalog/patch-map --",
    "js:performance:benchmark": "npm run performance:benchmark --workspace @conalog/patch-map --",
    "js:performance:extraction": "npm run performance:extraction --workspace @conalog/patch-map --",
    "js:performance:update": "npm run performance:update --workspace @conalog/patch-map --",
    "js:verify:memory": "npm run verify:memory --workspace @conalog/patch-map --",
    "js:verify:package": "npm run verify:package --workspace @conalog/patch-map --",
    "flutter:analyze": "cd packages/flutter && flutter analyze --no-pub lib test",
    "flutter:test": "cd packages/flutter && flutter test --no-pub --concurrency=2",
    "flutter:demo": "cd packages/flutter/example && flutter run --target=lib/bar_demo.dart",
    "flutter:verify:package": "node verification/flutter/package.mjs && node verification/flutter/installed-consumer.mjs",
    "verify:typecheck": "tsc --noEmit",
    "verify:lint": "eslint verification .github/scripts",
    "verify:tests": "node --test verification/conformance/*.test.mjs verification/flutter/installed-consumer.test.mjs .github/scripts/*.test.mjs",
    "verify:tooling": "npm run verify:typecheck && npm run verify:lint && npm run verify:tests",
    "verify:docs": "node verification/docs/verify.mjs",
    "verify:conformance": "node verification/conformance/inventory.mjs && node verification/conformance/run-public.mjs",
    "verify:conformance:serve": "vite --config verification/conformance/vite.config.ts --host 127.0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.9",
    "eslint": "10.7.0",
    "pixi.js": "8.19.0",
    "playwright": "1.57.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6"
  }
}
