{
  "name": "@conalog/patch-map",
  "version": "1.0.0-alpha.2",
  "description": "PATCH MAP renderer powered by PixiJS",
  "license": "MIT",
  "author": "Conalog",
  "homepage": "https://github.com/Conalog/patch-map#readme",
  "bugs": "https://github.com/Conalog/patch-map/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/Conalog/patch-map.git"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "docs/README.md",
    "docs/getting-started.md",
    "docs/api/data-and-targets.md",
    "docs/api/mutations-and-history.md",
    "docs/api/pointer-and-selection.md",
    "docs/api/viewport-and-transform.md",
    "docs/api/presentation.md",
    "docs/api/assets-and-capture.md",
    "docs/api/text.md",
    "docs/integration/host.md",
    "docs/compatibility.md",
    "docs/assets/fonts.md",
    "docs/assets/fira-code-6.2-license.txt",
    "examples/patch-map",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/verification/finalize-declarations.mjs",
    "build:lab": "vite build --config vite.patch-map-lab.config.ts",
    "lab": "vite --config vite.patch-map-lab.config.ts --host 127.0.0.1 --port 4176 --open '/lab/patch-map?scenario=LIF-001&size=100&seed=319'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "unit": "vitest run --maxWorkers=2",
    "test": "npm run typecheck && npm run lint && npm run unit",
    "verify:contract:decisions": "node scripts/verification/verify-patch-map-decision-evidence.mjs",
    "verify:contract:gates": "node scripts/verification/verify-patch-map-catalog-static-gates.mjs",
    "verify:contract:catalog": "node scripts/verification/verify-patch-map-catalog.mjs",
    "verify:contract": "npm run verify:contract:decisions && npm run verify:contract:gates && npm run verify:contract:catalog",
    "verify:docs": "node scripts/verification/verify-docs.mjs",
    "verify:performance-contract": "node performance/patch-map/report/verify-contract.mjs",
    "verify:lab": "node scripts/verification/patch-map-manual-lab-browser.mjs",
    "verify:lab:all": "node scripts/verification/patch-map-manual-lab-browser.mjs --all-routes",
    "verify:lab:10000": "node scripts/verification/patch-map-exploratory-10000-browser.mjs --headless",
    "verify:lab:actual-production": "node scripts/verification/patch-map-actual-production-browser.mjs --headless",
    "verify:package": "npm run build && node scripts/verification/patch-map-package.mjs",
    "verify:package:installed-selection": "node scripts/verification/patch-map-installed-selection-smoke.mjs",
    "verify:package:installed-builtins": "node scripts/verification/patch-map-installed-builtin-assets-smoke.mjs",
    "verify:memory": "node scripts/verification/patch-map-memory.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run verify:package -- --require-audit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.9",
    "eslint": "10.7.0",
    "pixi.js": "8.19.0",
    "playwright": "1.57.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.0"
  },
  "peerDependencies": {
    "pixi.js": ">=8.0.0 <9"
  }
}
